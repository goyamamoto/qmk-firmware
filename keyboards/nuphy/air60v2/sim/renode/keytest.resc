mach create "air60v2"
machine LoadPlatformDescription $ORIGIN/air60v2.gen.repl
machine LoadPlatformDescriptionFromString "led1: Mocks.DummyI2CSlave @ i2c1 0x50"
machine LoadPlatformDescriptionFromString "led2: Mocks.DummyI2CSlave @ i2c1 0x53"
sysbus LoadBinary $ORIGIN/ff.bin 0x08000000
sysbus.cpu PerformanceInMips 10
sysbus LoadELF $ORIGIN/../../../../../.build/nuphy_air60v2_ansi_renode.elf
logLevel 1
logLevel -1 sysbus.i2c1.led1
logLevel -1 sysbus.i2c1.led2
sysbus.usart1 CreateFileBackend $ORIGIN/uart_tx.bin true
sysbus.cpu AddHook 0x08005c24 "self.InfoLog('HOOK keyboard_init')"
sysbus.cpu AddHook 0x080027f0 "self.InfoLog('HOOK keyboard_post_init_nuphy')"
sysbus.cpu AddHook 0x08006468 "self.InfoLog('HOOK matrix_init')"
sysbus.cpu AddHook 0x08009604 "self.InfoLog('HOOK rgb_matrix_init')"
sysbus.cpu AddHook 0x08004010 "self.InfoLog('HOOK is31fl3733_init')"
sysbus.cpu AddHook 0x08001398 "self.InfoLog('HOOK nuphy_rf_transport_init')"
sysbus.cpu AddHook 0x080013a0 "self.InfoLog('HOOK nuphy_rf_device_init')"
sysbus.cpu AddHook 0x08000db8 "self.InfoLog('HOOK uart_send_cmd')"
sysbus.cpu AddHook 0x080027cc "self.InfoLog('HOOK housekeeping_task_nuphy')"
sysbus.cpu AddHook 0x0800b5b4 "self.InfoLog('HOOK chSysHalt')"
sysbus.cpu AddHook 0x08000196 "self.InfoLog('HOOK _unhandled_exception')"
sysbus.cpu AddHook 0x08005b78 "self.InfoLog('HOOK eeconfig_init')"
sysbus.cpu AddHook 0x0800a7b0 "self.InfoLog('HOOK i2c_init')"
sysbus.cpu AddHook 0x08009480 "self.InfoLog('HOOK rgb_matrix_task')"
sysbus.cpu AddHook 0x08006494 "self.InfoLog('HOOK matrix_scan')"
sysbus.cpu AddHook 0x08000b18 "self.InfoLog('HOOK uart_send_report')"
include $ORIGIN/nrf_stub.py
include $ORIGIN/gpio_pullups.resc
include $ORIGIN/keypress.py
emulation RunFor "0.05"
include $ORIGIN/gpio_pullups.resc
emulation RunFor "5.0"
echo "=== connected; press A (3,1)"
python "import air60; air60.press(3, 1)"
emulation RunFor "0.25"
python "import air60; air60.release(3, 1)"
emulation RunFor "0.25"
echo "=== press Z (4,2)"
python "import air60; air60.press(4, 2)"
emulation RunFor "0.25"
python "import air60; air60.release(4, 2)"
emulation RunFor "0.25"
echo "=== press Esc (0,0)"
python "import air60; air60.press(0, 0)"
emulation RunFor "0.25"
python "import air60; air60.release(0, 0)"
emulation RunFor "0.25"
echo "=== Fn (5,10) + 1 (1,1): expect F1 on the Win layer"
python "import air60; air60.press(5, 10)"
emulation RunFor "0.15"
python "import air60; air60.press(1, 1)"
emulation RunFor "0.25"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
echo "=== Fn+Tab: US-JIS on; then Shift+2 -> expect JIS @ (2F, no Shift); '=' -> expect Shift+2D"
python "import air60; air60.press(5, 10)"
emulation RunFor "0.15"
python "import air60; air60.press(2, 0)"
emulation RunFor "0.15"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
python "import air60; air60.press(4, 0)"
emulation RunFor "0.15"
python "import air60; air60.press(1, 2)"
emulation RunFor "0.25"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
python "import air60; air60.press(1, 12)"
emulation RunFor "0.25"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
echo "=== LShift + minus (1,11): expect Shift+87 (JIS backslash key) also over RF"
python "import air60; air60.press(4, 0)"
emulation RunFor "0.15"
python "import air60; air60.press(1, 11)"
emulation RunFor "0.25"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
echo "=== tap the key left of Space (5,2): expect Muhenkan 8B; hold it and press A: expect LAlt (04) + A"
python "import air60; air60.press(5, 2)"
emulation RunFor "0.08"
python "import air60; air60.release_all()"
emulation RunFor "1.0"
python "import air60; air60.press(5, 2)"
emulation RunFor "0.08"
python "import air60; air60.press(3, 1)"
emulation RunFor "0.25"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
echo "=== Caps position (3,0) is Left Ctrl (mods 01); Left Ctrl position (5,0) is Caps Lock (39)"
python "import air60; air60.press(3, 0)"
emulation RunFor "0.25"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
python "import air60; air60.press(5, 0)"
emulation RunFor "0.25"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
echo "=== tap the key right of Space (5,9): expect Henkan 8A"
python "import air60; air60.press(5, 9)"
emulation RunFor "0.08"
python "import air60; air60.release_all()"
emulation RunFor "0.4"
echo "=== Fn+Tab: US-JIS off; Shift+2 -> expect Shift+1F again"
python "import air60; air60.press(5, 10)"
emulation RunFor "0.15"
python "import air60; air60.press(2, 0)"
emulation RunFor "0.15"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
python "import air60; air60.press(4, 0)"
emulation RunFor "0.15"
python "import air60; air60.press(1, 2)"
emulation RunFor "0.25"
python "import air60; air60.release_all()"
emulation RunFor "0.3"
include $ORIGIN/nrf_report.py
include $ORIGIN/keyreport.py
quit
